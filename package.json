{
  "name": "steledb",
  "version": "0.1.1",
  "description": "A TypeScript library that treats a set of JSON files as a static relational database, deriving integrity validation and typed queries from one schema definition",
  "keywords": [
    "json",
    "database",
    "schema",
    "validation",
    "typed-query",
    "referential-integrity",
    "static-data",
    "typescript",
    "content",
    "ssg"
  ],
  "homepage": "https://github.com/masahosono/steledb#readme",
  "bugs": "https://github.com/masahosono/steledb/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masahosono/steledb.git"
  },
  "author": "masahosono (https://github.com/masahosono)",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "default": "./dist/studio/index.js"
    }
  },
  "bin": {
    "steledb": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && chmod +x dist/cli/main.js",
    "prepack": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:core-imports": "node scripts/check-core-imports.mjs",
    "check:example": "npm --prefix example install --no-audit --no-fund && npm --prefix example run check",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test && npm run check:core-imports && npm run check:example"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@biomejs/biome": true,
    "esbuild": true,
    "fsevents": false
  }
}
